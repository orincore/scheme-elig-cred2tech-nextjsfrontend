# NestJS backend (auth, CRM, bookmarks, eligibility proxy)
NEXT_PUBLIC_API_BASE_URL=https://your-backend-domain.com

# Socket Configuration (optional — NestJS CRM notifications)
NEXT_PUBLIC_SOCKET_URL=https://your-backend-domain.com

# AI Eligibility Check Engine (standalone) — used for scheme detail (REST)
# and live eligibility decisions/questions (WebSocket).
NEXT_PUBLIC_ELIGIBILITY_URL=https://your-eligibility-engine-domain.com
NEXT_PUBLIC_ELIGIBILITY_WS_URL=wss://your-eligibility-engine-domain.com
